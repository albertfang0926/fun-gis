{
  "files": ["./src/index.ts"],
  "include": ["src/**/*"],
  "compilerOptions": {
    "types": ["vite/client"],
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist/types",
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "skipLibCheck": true
  }
}
