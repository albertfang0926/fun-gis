{
  "type": "module",
  "files": ["./src/index.ts"],
  "include": ["src/**/*"],
  "compilerOptions": {
    "types": ["vite/client", "index.d.ts"],
    "lib": ["esnext", "dom"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "rootDir": "./src",
    "outDir": "./dist/types",
    "declaration": true,
    "emitDeclarationOnly": true
  }
}
